---
import Layout from '../layouts/Layout.astro'
import Hero from './Hero.astro'
import Waves from './Waves.astro'
import ProjectCard from './ProjectCard.astro'
import projects from '../data/projects.js'
import { getAllTools, slugifyTool } from '../data/tools'
import type { PageSchema } from '../layouts/Layout.astro'
import { itemList, projectItem, projectsCrumb } from '../data/schema'

const pills = [
  { slug: 'all', name: 'All Projects', href: '/projects#projects' },
  ...getAllTools(projects).map(tool => ({ ...tool, href: `/projects?tool=${tool.slug}#projects` })),
]

const title = 'Projects Matt Waler has built since 2016.'
const description = 'A non-exhaustive list of websites and iOS apps I built since I started my career in 2016.'

const schema: PageSchema = {
  type: 'CollectionPage',
  breadcrumbs: [projectsCrumb],
  page: {
    mainEntity: itemList(projects.map(projectItem)),
  },
}
---

<Layout title={title} description={description} schema={schema}>
  <Hero
    title="See what I've built."
    description="I have built a lot of websites and mobile applications since I started back in 2016. Listed below is a non-exhaustive representation of what I have developed and deployed."
  />

  <Waves rotate foreground="white" background="#f3f4f6" />

  <section id="projects" class="section scroll-mt-24 bg-gray-100">
    <div class="container space-y-12" x-data="filter('tool')">
      <nav aria-label="Filter projects by technology" class="flex flex-wrap justify-start gap-x-5 gap-y-3">
        {pills.map(pill => (
          <a
            href={pill.href}
            aria-current={pill.slug === 'all' ? 'true' : undefined}
            x-bind:aria-current={`active === '${pill.slug}' ? 'true' : null`}
            x-on:click={`select($event, '${pill.slug}')`}
            class="text-base font-medium transition-colors text-gray-500 hover:text-gray-900 aria-[current=true]:text-gray-900 aria-[current=true]:underline underline-offset-4"
          >
            {pill.name}
          </a>
        ))}
      </nav>
      <p class="sr-only" aria-live="polite" x-text="`Showing ${count} ${count === 1 ? 'project' : 'projects'}`"></p>
      <div x-ref="grid" class="relative grid content-start items-start grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-12">
        {projects.map(project => (
          <ProjectCard project={project} data-filters={project.tools.map(slugifyTool).join(' ')} />
        ))}
      </div>
    </div>
  </section>

  <Waves foreground="white" background="#f3f4f6" />

</Layout>
