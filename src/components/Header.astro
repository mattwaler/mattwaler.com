---
import Logo from '../icons/Logo.svg'
import Menu from '../icons/Menu.svg'
import Close from '../icons/Close.svg'
import navigation from '../data/navigation.js'
---

<header
  transition:persist
  class="absolute top-4 left-0 right-0 w-full z-50"
  x-data="{ showMobile: false }"
>
  <div class="container">
    <div
      x-ref="navigation"
      class="mx-auto rounded-full py-2 flex-wrap flex gap-x-4 gap-y-2 items-center justify-between w-full px-0"
    >
      <!-- Logo -->
      <div class="flex items-center justify-start flex-none lg:w-40">
        <a href="/" class="flex items-center gap-1">
          <Logo class="size-8" />
          <span class="text-lg font-medium">matt<span class="font-extrabold">waler</span></span>
        </a>
      </div>
      <!-- Desktop Links -->
      <div class="justify-center items-center gap-8 hidden lg:flex">
        {navigation.map(item => (
          <a class="font-medium opacity-90 whitespace-nowrap" href={item.route}>{item.name}</a>
        ))}
      </div>
      <!-- CTA & Menu -->
      <div class="flex-none items-center justify-end flex gap-4 lg:w-40">
        <a class="button max-[400px]:hidden" href="/contact/">Get In Touch</a>
        <button
          x-ref="menuButton"
          aria-label="toggle navigation"
          class="flex items-center justify-center lg:hidden"
          @click="showMobile = !showMobile"
        >
          <span x-show="!showMobile">
            <Menu class="size-6" />
          </span>
          <span x-show="showMobile" style="display:none">
            <Close class="size-6" />
          </span>
        </button>
      </div>
    </div>
    <!-- Mobile Links -->
    <div
      class="bg-white shadow-xl border-gray-100 overflow-clip w-56 flex flex-col divide-y divide-gray-100 rounded-2xl text-gray-900 lg:hidden"
      x-anchor.bottom-end.offset.16="$refs.menuButton"
      x-cloak
      x-transition.duration.300ms
      x-show="showMobile"
    >
      {navigation.map(item => (
        <a x-on:click="showMobile = false" class="font-medium px-4 py-3 hover:bg-gray-100 transition-colors" href={item.route}>{item.name}</a>
      ))}
    </div>
  </div>
</header>
