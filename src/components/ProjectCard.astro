---
import { projectImageUrl } from '../data/projects.js'

interface Props {
  project: {
    title: string
    description: string
    link: string
    tools: string[]
    trendy?: boolean
  }
  /** Space-separated tool slugs the projects filter matches against. */
  'data-filters'?: string
}

const { project, ...attrs } = Astro.props
const external = !project.link.startsWith('/')
---

<a
  {...attrs}
  href={project.link}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class="block bg-white hover:rotate-4 transition-transform rounded-xl shadow-xl overflow-clip group"
>
  <img
    width="1200"
    height="975"
    loading="lazy"
    class="aspect-1200/975 object-cover object-top w-full h-auto bg-gray-200"
    src={projectImageUrl(project)}
    alt=""
  />
  <div class="p-8 space-y-2 border-t-2">
    <span class="block text-sm text-gray-600">
      {project.tools.join(', ')}
    </span>
    <h4 class="text-lg font-bold text-pretty">{project.title}</h4>
    <p class="text-pretty">{project.description}</p>
    {project.trendy && (
      <span class="block text-sm italic text-gray-600">
        Completed while employed at TrendyMinds.
      </span>
    )}
  </div>
</a>
