---
interface Props {
  title: string
  description?: string
  titlePhrases?: string[]
  cta?: { label: string; href: string }
  tags?: { label: string; href: string }[]
  image?: { src: string; alt?: string; width: number; height: number }
}

const { title, description, titlePhrases, cta, tags, image } = Astro.props

const reserveTitle = titlePhrases?.length
  ? `${title} ${titlePhrases.reduce((a, b) => (a.length > b.length ? a : b))}`
  : undefined
---

<section class:list={['pb-12 pt-32 flex items-center justify-center', image ? 'md:pb-19 md:pt-38' : 'md:pb-24 md:pt-48']}>
  <div class:list={['container', image ? 'flex flex-col md:flex-row md:items-center gap-12 md:gap-16 max-w-6xl' : 'md:text-center']}>
    <div class:list={['space-y-6 overlap', image && 'md:w-[65%]']}>
      {reserveTitle && (
        <div class:list={['space-y-6 w-full max-w-3xl', !image && 'mx-auto']}>
          <p role="presentation" aria-hidden="true" class="h1 opacity-0">
            {reserveTitle}
          </p>
          {description && <p class="h6 opacity-75 text-balance">{description}</p>}
        </div>
      )}
      <div class:list={['space-y-6 w-full max-w-3xl', !image && 'mx-auto']}>
        <h1 class:list={["h1", !reserveTitle && (image ? 'text-pretty' : 'text-balance')]}>
          {titlePhrases?.length ? (
            <>
              {title}{' '}
              <span
                x-data={`{ typed: null, phrases: ${JSON.stringify(titlePhrases)} }`}
                x-init="() => typed = new Typed($el, { strings: phrases.slice(1), typeSpeed: 60, startDelay: 1500, backDelay: 1000 })"
                x-intersect:leave="typed.destroy(); $el.innerText = phrases[0]"
              >{titlePhrases[0]}</span>
            </>
          ) : title}
        </h1>
        {description && !reserveTitle && (
          <p class="h6 opacity-75 text-balance">
            {description}
          </p>
        )}
        {tags && tags.length > 0 && (
          <ul class:list={['flex flex-wrap gap-x-4 gap-y-1 pt-3', !image && 'md:justify-center']}>
            {tags.map(tag => (
              <li>
                <a
                  href={tag.href}
                  class="block text-base font-medium text-gray-600 hover:text-gray-900 transition-colors"
                >
                  {tag.label}
                </a>
              </li>
            ))}
          </ul>
        )}
        {cta && (
          <a href={cta.href} class="mt-3 button inline-block">
            {cta.label}
          </a>
        )}
      </div>
    </div>
    {image && (
      <div class="md:w-[35%]">
        <img
          src={image.src}
          alt={image.alt ?? ''}
          width={image.width}
          height={image.height}
          fetchpriority="high"
          class="w-2/3 sm:w-1/2 md:w-auto md:max-w-full md:max-h-[min(65svh,560px)] mx-auto md:mr-0"
        />
      </div>
    )}
  </div>
</section>
