---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import Hero from './Hero.astro'
import Waves from './Waves.astro'
import BlogCard from './BlogCard.astro'
import { getAllTags, slugifyTag } from '../data/tags'

interface Props {
  activeSlug?: string
}

const { activeSlug } = Astro.props

const allPosts = await getCollection('blog')
const posts = allPosts
  .filter(post => !activeSlug || (post.data.tags ?? []).some(tag => slugifyTag(tag) === activeSlug))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const tags = getAllTags(allPosts)
const pills = [
  {
    slug: 'all',
    name: 'All Posts',
    active: !activeSlug,
    href: '/blog/#posts',
  },
  ...tags.map(tag => ({
    ...tag,
    active: tag.slug === activeSlug,
    href: tag.slug === activeSlug ? '/blog/#posts' : `/blog/tags/${tag.slug}/#posts`,
  })),
]

const activeName = tags.find(tag => tag.slug === activeSlug)?.name
const title = activeName
  ? `Read Matt Waler's blog posts about ${activeName}.`
  : "Read Matt Waler's thoughts and ramblings on web development, app development, and life."
---

<Layout
  title={title}
  description="Coding tips, tech rants, coffee-fueled tutorials, and the occasional meme. Come for the bugs, stay for the fixes!"
>
  <Hero
    title="Sneak a peek inside my head."
    description="Sorry, you're probably going to regret doing that. Here on my blog you will find coding tips, tech rants, coffee-fueled tutorials, and the occasional meme. We don't have a ton here just yet, but don't worry, more is on the way!"
    cta={{ label: "Subscribe via RSS", href: "/rss.xml" }}
  />

  <Waves />

  <section id="posts" class="section scroll-mt-24 bg-linear-to-t from-blue-600 to-blue-950 to-90%">
    <div class="container space-y-12">
      <nav aria-label="Filter posts by category" class="flex flex-wrap justify-start gap-x-5 gap-y-3">
        {pills.map(pill => (
          <a
            href={pill.href}
            aria-current={pill.active ? 'true' : undefined}
            class:list={[
              'text-base font-medium transition-colors',
              pill.active
                ? 'text-white underline underline-offset-4'
                : 'text-white/60 hover:text-white',
            ]}
          >
            {pill.name}
          </a>
        ))}
      </nav>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        {posts.map(post => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <Waves rotate foreground="#155dfc" />

</Layout>
