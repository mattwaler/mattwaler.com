---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import Hero from './Hero.astro'
import Waves from './Waves.astro'
import BlogCard from './BlogCard.astro'
import { getAllTags, slugifyTag } from '../data/tags'
import type { PageMeta } from '../layouts/Layout.astro'
import { blog, blogCrumb, blogRef, postSummary } from '../data/schema'

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const pills = [
  { slug: 'all', name: 'All Posts', href: '/blog#posts' },
  ...getAllTags(posts).map(tag => ({ ...tag, href: `/blog?tag=${tag.slug}#posts` })),
]

const postSummaries = posts.map(postSummary)

const meta: PageMeta = {
  title: "Matt Waler's blog on web and iOS development",
  description: 'Coding tips, tech rants, coffee-fueled tutorials, and the occasional meme. Come for the bugs, stay for the fixes!',
  schema: {
    type: 'CollectionPage',
    breadcrumbs: [blogCrumb],
    page: { mainEntity: blogRef },
    nodes: [{ ...blog, blogPost: postSummaries }],
  },
}
---

<Layout meta={meta}>
  <Hero
    title="Sneak a peek inside my head."
    description="Sorry, you're probably going to regret doing that. Here on my blog you will find coding tips, tech rants, coffee-fueled tutorials, and the occasional meme. We don't have a ton here just yet, but don't worry, more is on the way!"
    cta={{ label: "Subscribe via RSS", href: "/rss.xml" }}
  />

  <Waves />

  <section id="posts" class="section scroll-mt-24 bg-linear-to-t from-blue-600 to-blue-950 to-90%">
    <div class="container space-y-12" x-data="filter('tag')">
      <nav aria-label="Filter posts by category" class="flex flex-wrap justify-start gap-x-5 gap-y-3">
        {pills.map(pill => (
          <a
            href={pill.href}
            aria-current={pill.slug === 'all' ? 'true' : undefined}
            x-bind:aria-current={`active === '${pill.slug}' ? 'true' : null`}
            x-on:click={`select($event, '${pill.slug}')`}
            class="text-base font-medium transition-colors text-white/60 hover:text-white aria-[current=true]:text-white aria-[current=true]:underline underline-offset-4"
          >
            {pill.name}
          </a>
        ))}
      </nav>
      <p class="sr-only" aria-live="polite" x-text="`Showing ${count} ${count === 1 ? 'post' : 'posts'}`"></p>
      <div x-ref="grid" class="relative grid content-start grid-cols-1 lg:grid-cols-2 gap-12">
        {posts.map(post => (
          <BlogCard post={post} data-filters={(post.data.tags ?? []).map(slugifyTag).join(' ')} />
        ))}
      </div>
    </div>
  </section>

  <Waves rotate foreground="#155dfc" />

</Layout>
