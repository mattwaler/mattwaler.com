---
import ArrowUp from '../icons/ArrowUp.svg'

interface Props {
  label: string
  cols?: 2 | 3
  /** Link to the full listing, shown at the right of the controls. */
  cta?: { label: string; href: string }
}

const { label, cols = 3, cta } = Astro.props
const trackId = `carousel-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
---

<div
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  x-data="{
    canPrev: false,
    canNext: false,
    snaps: 0,
    selected: 0,
    init() {
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches
      // Kept out of Alpine's reactive data so Embla's internals aren't proxied
      const embla = EmblaCarousel($refs.viewport, {
        // Snap cards to the edge of the shadow padding, not the viewport edge
        align: () => parseFloat(getComputedStyle($refs.track).paddingLeft),
      })
      const sync = () => {
        this.canPrev = embla.canScrollPrev()
        this.canNext = embla.canScrollNext()
        this.snaps = embla.scrollSnapList().length
        this.selected = embla.selectedScrollSnap()
        // Keep keyboard focus when the focused arrow is disabled at either end
        if (!this.canPrev && document.activeElement === $refs.prev && this.canNext) $refs.next.focus()
        if (!this.canNext && document.activeElement === $refs.next && this.canPrev) $refs.prev.focus()
      }
      embla.on('select', sync).on('reInit', sync)
      sync()
      this.go = direction => direction < 0 ? embla.scrollPrev(reduceMotion) : embla.scrollNext(reduceMotion)
      this.goTo = index => embla.scrollTo(index, reduceMotion)
      this.destroy = () => embla.destroy()
    },
  }"
>
  <!-- Embla viewport; it bleeds into the padding so card shadows and edges fade instead of clipping -->
  <div
    x-ref="viewport"
    class="-mx-8 -my-10 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_2rem,black_calc(100%-2rem),transparent)]"
  >
    <div
      id={trackId}
      x-ref="track"
      class:list={[
        'flex gap-12 px-8 py-10 touch-pan-y touch-pinch-zoom',
        // Embla reads the end gap from the last slide's margin, not the container padding
        '*:last:mr-8',
        // Cards fill the view exactly, so every snap shows whole cards
        '*:shrink-0 *:w-full md:*:w-[calc((100%-3rem)/2)]',
        cols === 3 && 'xl:*:w-[calc((100%-6rem)/3)]',
      ]}
    >
      <slot />
    </div>
  </div>

  <!--
    Controls below the cards: arrows for mouse and trackpad, dots for touch (which can swipe).
    Centered on their own, or on the left with the CTA on the right. The arrows always show,
    disabled when every card fits, so carousels look alike; a lone dot is left out.
  -->
  <div class:list={['flex items-center gap-6 mt-8', cta ? 'justify-between' : 'justify-center']}>
    <div>
      <div class="flex gap-3 pointer-coarse:hidden">
        {[
          { direction: -1, ref: 'prev', label: 'Previous', disabled: '!canPrev', rotate: '-rotate-90' },
          { direction: 1, ref: 'next', label: 'Next', disabled: '!canNext', rotate: 'rotate-90' },
        ].map(button => (
          <button
            type="button"
            x-ref={button.ref}
            aria-label={button.label}
            aria-controls={trackId}
            x-on:click={`go(${button.direction})`}
            x-bind:disabled={button.disabled}
            disabled
            class:list={[
              // Matches the back to top button
              'p-3 rounded-full bg-black text-white shadow-lg',
              'transition-[background-color,opacity] cursor-pointer enabled:hover:bg-gray-800',
              'disabled:opacity-50 disabled:cursor-not-allowed',
              'focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-blue-500',
            ]}
          >
            <ArrowUp class:list={['size-5', button.rotate]} aria-hidden="true" />
          </button>
        ))}
      </div>
      <div class="hidden pointer-coarse:flex flex-wrap items-center" x-show="snaps > 1">
        <template x-for="index in snaps" x-bind:key="index">
          <button
            type="button"
            class="p-1.5 rounded-full cursor-pointer group/dot focus-visible:outline-3 focus-visible:outline-blue-500"
            aria-controls={trackId}
            x-bind:aria-label="`Go to slide ${index}`"
            x-bind:aria-current="index - 1 === selected ? 'true' : null"
            x-on:click="goTo(index - 1)"
          >
            <span
              class="block h-2.5 rounded-full bg-black transition-all duration-300"
              x-bind:class="index - 1 === selected ? 'w-6' : 'w-2.5 opacity-25 group-hover/dot:opacity-50'"
            ></span>
          </button>
        </template>
      </div>
    </div>
    {cta && (
      <a href={cta.href} class="button ml-auto shrink-0 inline-flex items-center gap-2 group/cta">
        {cta.label}
        <ArrowUp class="size-4 rotate-90 transition-transform group-hover/cta:translate-x-0.5" aria-hidden="true" />
      </a>
    )}
  </div>
</div>
