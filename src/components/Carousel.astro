---
import ArrowUp from '../icons/ArrowUp.svg'

interface Props {
  label: string
  cols?: 2 | 3
}

const { label, cols = 3 } = Astro.props
const trackId = `carousel-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
---

<div
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  x-data="{
    atStart: true,
    atEnd: false,
    update() {
      const track = $refs.track
      this.atStart = track.scrollLeft <= 1
      this.atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1
      // Keep keyboard focus when the focused arrow is disabled at either end
      if (this.atStart && document.activeElement === $refs.prev && !this.atEnd) $refs.next.focus()
      if (this.atEnd && document.activeElement === $refs.next && !this.atStart) $refs.prev.focus()
    },
    go(direction) {
      const track = $refs.track
      const step = track.firstElementChild.offsetWidth + parseFloat(getComputedStyle(track).columnGap)
      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches
      track.scrollBy({ left: direction * step, behavior: smooth ? 'smooth' : 'auto' })
    },
  }"
  x-init="update()"
  x-on:resize.window.debounce.100ms="update()"
>
  <!-- Inset by the arrow (32px, 44px from md) plus an 8px gap so the arrows never overlap the cards -->
  <div class="relative px-10 md:px-13">
    <!-- Arrows sit beside the cards, halfway up, and come first in tab order -->
    {[
      { direction: -1, ref: 'prev', label: 'Previous', disabled: 'atStart', side: 'left-0', rotate: '-rotate-90' },
      { direction: 1, ref: 'next', label: 'Next', disabled: 'atEnd', side: 'right-0', rotate: 'rotate-90' },
    ].map(button => (
      <button
        type="button"
        x-ref={button.ref}
        aria-label={button.label}
        aria-controls={trackId}
        x-on:click={`go(${button.direction})`}
        x-bind:disabled={button.disabled}
        x-show="!(atStart && atEnd)"
        x-cloak
        class:list={[
          // Matches the back to top button
          'absolute top-1/2 -translate-y-1/2 z-10 p-2 md:p-3 rounded-full bg-black text-white shadow-lg',
          'transition-[background-color,opacity] cursor-pointer enabled:hover:bg-gray-800',
          'disabled:opacity-50 disabled:cursor-not-allowed',
          'focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-blue-500',
          button.side,
        ]}
      >
        <ArrowUp class:list={['size-4 md:size-5', button.rotate]} aria-hidden="true" />
      </button>
    ))}
    <!-- Padding gives card shadows and hover tilt room inside the scroll area -->
    <div
      id={trackId}
      x-ref="track"
      x-on:scroll.debounce.50ms="update()"
      class:list={[
        'flex gap-12 overflow-x-auto snap-x snap-mandatory scrollbar-none fade-x fade-size-x-[2rem]',
        '-mx-8 px-8 scroll-px-8 -my-10 py-10',
        // Cards fill the view exactly, so every snap point shows whole cards and the
        // fade only touches the edge padding as cards slide past
        '*:shrink-0 *:snap-start *:w-full md:*:w-[calc((100%-3rem)/2)]',
        // Cards tilt on hover elsewhere, but not while they sit in a scrolling row
        '*:rotate-none!',
        cols === 3 && 'xl:*:w-[calc((100%-6rem)/3)]',
      ]}
    >
      <slot />
    </div>
  </div>
</div>
