---
import Github from '../icons/Github.svg'
import Instagram from '../icons/Instagram.svg'
import LinkedIn from '../icons/LinkedIn.svg'

const socials = [
  { name: 'GitHub', url: 'https://github.com/mattwaler', Icon: Github },
  { name: 'Instagram', url: 'https://instagram.com/mattwaler', Icon: Instagram },
  { name: 'LinkedIn', url: 'https://linkedin.com/in/mattwaler', Icon: LinkedIn },
]

// With `build.format: 'file'`, Astro.url.pathname is `/contact.html` at build time
// but `/contact` in the browser — normalize so both match.
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1')
const pageLinks = [
  { name: 'Privacy Policy', url: '/privacy-policy' },
  { name: 'AI Disclosure', url: '/ai-disclosure' },
]

const noCtaLinks = [
  '/contact', '/dad', '/klaus'
]
---

{!noCtaLinks.includes(pathname) && (
  <section class="py-24">
    <div class="container md:text-center text-balance max-w-3xl mx-auto">
      <h2 class="h2">Let's work together.</h2>
      <p class="h6 mt-3">
        Have a project in mind, or just want to say hello? I'd love to hear from you.
      </p>
      <div class="mt-9">
        <a href="/contact" class="button">Get in Touch</a>
      </div>
    </div>
  </section>
)}

<footer class="text-gray-600">
  <div class="mx-auto container py-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div class="flex justify-start items-center gap-x-5 md:order-3">
      {socials.map(({ name, url, Icon }) => (
        <a
          class="hover:text-gray-900 transition-colors"
          target="_blank"
          rel="noopener noreferrer"
          href={url}
        >
          <span class="sr-only">{name}</span>
          <Icon class="size-5.5" />
        </a>
      ))}
    </div>
    <nav aria-label="Site policies" class="flex flex-wrap gap-x-5 gap-y-1 text-sm/6 font-medium md:order-2">
      {pageLinks.map(({ name, url }) => (
        <a href={url} class="hover:text-gray-900 transition-colors">{name}</a>
      ))}
    </nav>
    <p class="font-medium text-sm/6 md:order-1">
      &copy; {new Date().getFullYear()} Waler Media, LLC. All rights reserved.
    </p>
  </div>
</footer>
