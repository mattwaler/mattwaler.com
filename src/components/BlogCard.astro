---
interface Props {
  post: any
  /** Space-separated tag slugs the blog filter matches against. */
  'data-filters'?: string
}

import { slugifyTag } from '../data/tags'
import { formatDate, isoDate } from '../data/dates'

const { post, ...attrs } = Astro.props
---

<a
  {...attrs}
  href={`/blog/${post.id.replace(/\.md$/, '')}`}
  class="bg-white hover:rotate-4 transition-transform border rounded-xl shadow-xl overflow-clip"
>
  <div class="p-8 space-y-2">
    <time datetime={isoDate(post.data.date)} class="block text-sm text-gray-600">
      {formatDate(post.data.date)}
    </time>
    <h4 class="h5 text-pretty">
      <span class="block font-bold">
        {post.data.title}
      </span>
    </h4>
    <p class="text-pretty lg:line-clamp-3">{post.data.description}</p>
    {post.data.tags?.length > 0 && (
      <ul class="flex flex-wrap gap-x-2 gap-y-1">
        {post.data.tags.map((tag: string) => (
          <li class="text-sm text-gray-600">
            #{slugifyTag(tag)}
          </li>
        ))}
      </ul>
    )}
  </div>
</a>
