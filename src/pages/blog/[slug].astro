---
import { getCollection, render } from "astro:content";
import Markdown from "../../layouts/Markdown.astro";
import type { PageMeta } from "../../layouts/Layout.astro";
import type { CollectionEntry } from "astro:content";
import { blog, blogCrumb, blogRef, personRef, postId, postUrl } from "../../data/schema";
import SectionHeading from "../../components/SectionHeading.astro";
import BlogCard from "../../components/BlogCard.astro";
import Carousel from "../../components/Carousel.astro";
import { formatDate, isoDate } from "../../data/dates";
import { cdn } from "../../data/images.js";

export async function getStaticPaths() {
  const posts: CollectionEntry<'blog'>[] = await getCollection("blog") ;

  // Up to five other posts, ranked by how many tags they share, then newest first
  const relatedPosts = (post: CollectionEntry<'blog'>) => {
    const tags = new Set(post.data.tags ?? [])
    return posts
      .filter((other) => other.id !== post.id)
      .map((other) => ({ other, shared: (other.data.tags ?? []).filter((tag) => tags.has(tag)).length }))
      .filter(({ shared }) => shared > 0)
      .sort((a, b) => b.shared - a.shared || b.other.data.date.valueOf() - a.other.data.date.valueOf())
      .slice(0, 5)
      .map(({ other }) => other)
  }

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post) },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);

const url = postUrl(post)
const published = isoDate(post.data.date)
const modified = isoDate(post.data.updated ?? post.data.date)
const wordCount = post.body?.split(/\s+/).filter(Boolean).length

const meta: PageMeta = {
  title: post.data.title,
  description: post.data.description,
  schema: {
    type: 'WebPage',
    breadcrumbs: [blogCrumb, { name: post.data.title, url }],
    page: {
      datePublished: published,
      dateModified: modified,
      keywords: post.data.tags,
      mainEntity: { '@id': postId(post) },
    },
    nodes: [
      blog,
      {
        '@type': 'BlogPosting',
        '@id': postId(post),
        headline: post.data.title,
        description: post.data.description,
        url,
        mainEntityOfPage: { '@id': url },
        isPartOf: blogRef,
        inLanguage: 'en-US',
        datePublished: published,
        dateModified: modified,
        author: personRef,
        publisher: personRef,
        image: new URL('/og-image.png', Astro.site).href,
        keywords: post.data.tags,
        articleSection: post.data.tags?.[0],
        wordCount,
      },
    ],
  },
}
---

<Markdown meta={meta} tags={post.data.tags}>
  <time slot="eyebrow" datetime={published}>{formatDate(post.data.date)}</time>
  <Content />
  <aside aria-label="About the author" class="mt-12 pt-8 border-t border-gray-300 flex flex-col sm:flex-row sm:items-center gap-6">
    <!-- A tall portrait beside the text on wider screens, cropped to the faces on phones -->
    <div class="relative h-56 sm:h-48 sm:w-28 shrink-0 rounded-xl overflow-clip">
      <img
        src={cdn('masonry/masonry-2.webp')}
        alt="Matt Waler"
        width="1235"
        height="1852"
        loading="lazy"
        class="absolute inset-0 size-full object-cover object-[50%_30%]"
      />
    </div>
    <div class="flex-1 text-sm/relaxed md:text-base/relaxed">
      <p class="!m-0 text-sm text-gray-600">Written by</p>
      <p class="!m-0 text-lg md:text-xl font-bold"><a href="/" rel="author" class="!no-underline hover:!underline">Matt Waler</a></p>
      <!-- Kept on one line: Astro drops the whitespace at line breaks next to inline tags -->
      <p class="!mt-3 !mb-0">I'm a web and iOS developer in Ohio, building websites at TrendyMinds by day and iPhone apps like <a href="/repeaters">Repeaters</a> and <a href="/intervals">Intervals</a> by night.</p>
      <p class="!mt-3 !mb-0">If you liked this post, <a href="/rss.xml">subscribe to  the RSS feed!</a></p>
    </div>
  </aside>
  {/* A lone related post doesn't earn its own section */}
  {related.length >= 2 && (
    <Fragment slot="after">
      <SectionHeading title="What else is Matt Waler thinking?" subtitle="Made it this far? These might be up your alley too." tone="cta" />
      <div class="mt-12">
        <Carousel
          label="Related posts"
          cols={related.length === 2 ? 2 : 3}
          cta={{ label: 'View All Posts', href: '/blog' }}
        >
          {related.map((post) => <BlogCard post={post} />)}
        </Carousel>
      </div>
    </Fragment>
  )}
</Markdown>
