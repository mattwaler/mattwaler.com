---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import Waves from '../components/Waves.astro'
import projects from '../data/projects.js'
import ProjectCard from '../components/ProjectCard.astro'

const title = 'Projects Matt Waler has built since 2016.'
const description = 'Professional websites and iOS apps built for performance, scalability, and user experience — built to meet client and developer needs.'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: 'https://mattwaler.com/projects/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.title,
      description: project.description,
      url: project.link,
    })),
  },
}
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Hero
    title="See what I've built."
    description="I have built a lot of websites and mobile applications since I started back in 2016. Listed below is a non-exhaustive representation of what I have developed and deployed."
  />

  <Waves rotate foreground="white" background="#f3f4f6" />

  <section class="section bg-gray-100">
    <div class="container grid items-start grid-cols-1 xl:grid-cols-3 gap-12">
      {projects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <Waves foreground="white" background="#f3f4f6" />

</Layout>
