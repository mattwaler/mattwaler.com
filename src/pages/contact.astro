---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import Waves from '../components/Waves.astro'
import ContactForm from '../components/ContactForm.astro'
import type { PageMeta } from '../layouts/Layout.astro'
import { SITE, personRef } from '../data/schema'

const meta: PageMeta = {
  title: 'Contact Matt Waler about your next website or application.',
  description: 'Get in touch with Matt Waler to start your next web or mobile application.',
  schema: {
    type: 'ContactPage',
    breadcrumbs: [{ name: 'Contact', url: `${SITE}/contact` }],
    page: { about: personRef, mainEntity: personRef },
  },
}
---

<Layout meta={meta}>
  <Hero
    title="Let's get in touch."
    description="Thank you for taking the time to view my website. If you are interested in connecting, fill out the contact form below. I will get back to you as soon as possible."
  />

  <Waves />
  <section id="contact" class="text-white bg-linear-to-t from-blue-600 to-blue-950 to-90%">
    <div class="container section max-w-3xl">
      <ContactForm />
    </div>
  </section>
  <Waves rotate foreground='#155dfc' />
</Layout>
