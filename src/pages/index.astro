---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import Waves from '../components/Waves.astro'
import SectionHeading from '../components/SectionHeading.astro'
import RecentProjects from '../components/RecentProjects.astro'
import RecentPosts from '../components/RecentPosts.astro'
import Tailwind from '../icons/Tailwind.svg'
import Alpine from '../icons/Alpine.svg'
import AstroIcon from '../icons/AstroIcon.svg'
import Nextjs from '../icons/Nextjs.svg'
import Typescript from '../icons/Typescript.svg'
import Swift from '../icons/Swift.svg'
import Statamic from '../icons/Statamic.svg'
import Laravel from '../icons/Laravel.svg'
import type { PageMeta } from '../layouts/Layout.astro'
import { personRef } from '../data/schema'
import { cdn } from '../data/images.js'

// Dimensions let the grid reserve space before each image arrives
const masonry = [
  { file: 'masonry-8.webp', width: 579, height: 772 },
  { file: 'forehand-1080.mp4', width: 1080, height: 1080 },
  { file: 'masonry-10.webp', width: 1071, height: 1428 },
  { file: 'masonry-4.webp', width: 576, height: 384 },
  { file: 'masonry-2.webp', width: 1235, height: 1852 },
  { file: 'masonry-1.webp', width: 1071, height: 1428 },
  { file: 'bench-1080.mp4', width: 1080, height: 1080 },
  { file: 'masonry-3.webp', width: 576, height: 384 },
  { file: 'serve-1080.mp4', width: 1080, height: 1080 },
  { file: 'masonry-9.webp', width: 579, height: 772 },
  { file: 'masonry-5.webp', width: 576, height: 384 },
].map(asset => ({ ...asset, src: cdn(`masonry/${asset.file}`) }))

const tools = [
  { name: 'Tailwind', Icon: Tailwind },
  { name: 'Alpine', Icon: Alpine },
  { name: 'Astro', Icon: AstroIcon },
  { name: 'Next.js', Icon: Nextjs },
  { name: 'TypeScript', Icon: Typescript },
  { name: 'Swift', Icon: Swift },
  { name: 'Statamic', Icon: Statamic },
  { name: 'Laravel', Icon: Laravel },
]

const meta: PageMeta = {
  title: 'Matt Waler builds websites, iOS apps, and plays a ton of tennis.',
  description: 'Matt Waler is an Ohio-based web and iOS developer who builds websites with Laravel, Statamic, Craft CMS, and Astro, plus native iPhone apps in Swift.',
  // The home page is Matt's profile, so the Person is its main entity.
  schema: {
    type: 'ProfilePage',
    page: { about: personRef, mainEntity: personRef },
  },
}
---

<Layout meta={meta}>
  <!-- Hero -->
  <Hero
    title="I develop websites, iOS applications, and"
    titlePhrases={[
      'play far too much Tennis.',
      'listen to too much mgk.',
      'overly update my website.',
      'order too much Chipotle.',
    ]}
    description="I also have a wife, a french bulldog, and an obsession with pragmatism."
  />

  <!-- Skills -->
  <Waves />
  <section class="relative z-2 bg-white section bg-linear-to-b from-blue-950 to-blue-600">
    <div>
      <SectionHeading title="What does Matt Waler do?" subtitle="Oh, you want to talk shop? Let's get right to it." tone="dark" class="container" />
      <div class="container text-base mt-12 text-balance md:text-center md:max-w-3xl mx-auto">
        <p class="text-lg text-blue-200">Whether it's a static website or a full-blown iOS application, I'm all about taking ideas and turning them into something tangible. I pride myself on keeping my code simple, practical, and easy to maintain, resorting to complexity only when absolutely necessary.</p>
      </div>
      <div class="overflow-hidden w-full mt-16">
        <div class="flex w-max animate-marquee">
          {[...tools, ...tools, ...tools, ...tools].map(({ name, Icon }) => (
            <div class="flex flex-col items-center gap-2.5 w-20 mr-16">
              <Icon class="size-12 text-white" />
              <p class="text-xs text-blue-100 font-mono text-center">{name}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="container mt-12 flex flex-wrap gap-3 md:justify-center">
        <a href="/freelance-web-development" class="button">Web Development</a>
        <a href="/freelance-mobile-application-development" class="button">App Development</a>
      </div>
    </div>
  </section>

  <!-- Masonry -->
  <Waves rotate foreground="#155dfc" />
  <section class="bg-white section space-y-12 md:space-y-24">
    <SectionHeading title="Who is Matt Waler?" subtitle="They always say to show, not tell." class="container" />
    <div
      class="grid grid-cols-[repeat(auto-fill,minmax(120px,1fr))] md:grid-cols-[repeat(auto-fill,minmax(280px,1fr))] container max-w-none gap-3 md:gap-5 grid-rows-[masonry]"
      x-init="new window.Masonry($el)"
    >
      {masonry.map(asset => (
        asset.file.endsWith('.mp4') ? (
          <video
            x-data="{ show: false }"
            x-intersect:enter.threshold.75="show = true"
            x-intersect:enter.margin.400px.once="if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { $el.src = $el.dataset.src; $el.play().catch(() => {}) }"
            x-bind:class="show ? 'opacity-100' : 'opacity-0'"
            class="rounded-xl transition-opacity duration-500 pointer-events-none w-full h-auto"
            width={asset.width}
            height={asset.height}
            poster={asset.src.replace('.mp4', '-poster.webp')}
            data-src={asset.src}
            preload="none"
            muted playsinline loop
          ></video>
        ) : (
          <img
            x-data="{ show: false }"
            x-intersect:enter.threshold.75="show = true"
            x-bind:class="show ? 'opacity-100' : 'opacity-0'"
            src={asset.src}
            width={asset.width}
            height={asset.height}
            loading="lazy"
            decoding="async"
            class="rounded-xl transition-opacity duration-500 w-full h-auto"
            alt=""
          />
        )
      ))}
    </div>
  </section>

  <!-- Projects -->
  <Waves foreground="#f3f4f6" />
  <RecentProjects />

  <!-- Blog -->
  <Waves foreground="#162456" background="white" />
  <RecentPosts />
  <Waves rotate foreground="#155dfc" />

</Layout>
