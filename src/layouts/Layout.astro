---
import { ClientRouter } from "astro:transitions";
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Debug from '../components/Debug.astro'
import '../styles/app.css'

interface Props {
  title: string
  description?: string
  ogImage?: string
}

const { title, description = '', ogImage } = Astro.props

// With `build.format: 'file'`, Astro.url.pathname is `/contact.html` at build time
// but `/contact` in the browser — normalize to the URL the site actually serves.
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''),
  Astro.site
).href.replace(/(.)\/$/, '$1')

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Matt Waler',
  url: 'https://mattwaler.com',
  jobTitle: 'Web & iOS Developer',
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'OH',
    addressCountry: 'US',
  },
  sameAs: [
    'https://github.com/mattwaler',
    'https://instagram.com/mattwaler',
    'https://linkedin.com/in/mattwaler',
  ],
}

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'mattwaler.com',
  url: 'https://mattwaler.com',
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style is:global>
      [x-cloak] { display: none!important; }
    </style>
    <meta name="robots" content="index, follow, noodp, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <meta http-equiv="Pragma" content="cache">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="canonical" href={canonical}>
    <link rel="icon" type="image/svg+xml" crossorigin="anonymous" href="/logo.svg">
    <link rel="sitemap" href="/sitemap-index.xml">
    <link rel="alternate" type="application/rss+xml" title="Matt Waler's Blog" href="/rss.xml">
    <meta name="geo.region" content="US-OH">
    <meta name="author" content="Matt Waler">
    <meta name="publisher" content="Matt Waler">
    <meta name="copyright" content="Matt Waler">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:type" content="website">
    <meta property="og:image" content={new URL(ogImage ?? '/og-image.png', Astro.site).href}>
    <meta property="og:image:width" content="1800">
    <meta property="og:image:height" content="1200">
    <meta property="og:locale" content="en_US">
    <meta property="og:site_name" content="mattwaler.com">
    <ClientRouter />
    <title>{title} | TEA Stack</title>
    <meta name="description" content={description}>
    <meta name="abstract" content={description}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400..900&display=swap" rel="stylesheet">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <Debug />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/app.js'
    </script>
  </body>
</html>
