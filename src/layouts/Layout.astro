---
import { ClientRouter } from "astro:transitions";
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Debug from '../components/Debug.astro'
import ArrowUp from '../icons/ArrowUp.svg'
import '../styles/app.css'
import {
  SITE,
  person,
  website,
  websiteRef,
  breadcrumbList,
  type SchemaNode,
  type Breadcrumb,
} from '../data/schema'

export interface PageSchema {
  /** Schema.org type(s) for this page's WebPage node. Defaults to `WebPage`. */
  type?: string | string[]
  /** Extra properties merged into the WebPage node (e.g. `mainEntity`, `about`, `datePublished`). */
  page?: SchemaNode
  /** Trail ending at the current page; `Home` is prepended automatically. */
  breadcrumbs?: Breadcrumb[]
  /** Additional nodes to include in the page's graph. Reference the page via `{ '@id': canonical }`. */
  nodes?: SchemaNode[]
}

interface Props {
  title: string
  description?: string
  ogImage?: string
  schema?: PageSchema
}

const { title, description = '', ogImage, schema = {} } = Astro.props

// With `build.format: 'file'`, Astro.url.pathname is `/contact.html` at build time
// but `/contact` in the browser — normalize to the URL the site actually serves.
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''),
  Astro.site
).href.replace(/(.)\/$/, '$1')

const ogImageUrl = new URL(ogImage ?? '/og-image.png', Astro.site).href

const breadcrumbs = schema.breadcrumbs?.length
  ? [{ name: 'Home', url: SITE }, ...schema.breadcrumbs]
  : undefined

const breadcrumbId = `${canonical}#breadcrumb`

const webPage: SchemaNode = {
  '@type': schema.type ?? 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'en-US',
  isPartOf: websiteRef,
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl, width: 1800, height: 1200 },
  ...(breadcrumbs && { breadcrumb: { '@id': breadcrumbId } }),
  ...schema.page,
}

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    website,
    webPage,
    ...(breadcrumbs ? [{ '@id': breadcrumbId, ...breadcrumbList(breadcrumbs) }] : []),
    ...(schema.nodes ?? []),
  ],
}

// Article pages advertise themselves to Open Graph consumers as articles.
const article = schema.page?.datePublished
  ? {
      published: String(schema.page.datePublished),
      modified: String(schema.page.dateModified ?? schema.page.datePublished),
      tags: (schema.page.keywords as string[] | undefined) ?? [],
    }
  : undefined
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style is:global>
      [x-cloak] { display: none!important; }
    </style>
    <meta name="robots" content="index, follow, noodp, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <meta http-equiv="Pragma" content="cache">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="canonical" href={canonical}>
    <link rel="icon" type="image/svg+xml" crossorigin="anonymous" href="/logo.svg">
    <link rel="sitemap" href="/sitemap-index.xml">
    <link rel="alternate" type="application/rss+xml" title="Matt Waler's Blog" href="/rss.xml">
    <meta name="geo.region" content="US-OH">
    <meta name="author" content="Matt Waler">
    <meta name="publisher" content="Matt Waler">
    <meta name="copyright" content="Matt Waler">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:type" content={article ? 'article' : 'website'}>
    {article && (
      <>
        <meta property="article:published_time" content={article.published}>
        <meta property="article:modified_time" content={article.modified}>
        <meta property="article:author" content={SITE}>
        {article.tags.map(tag => <meta property="article:tag" content={tag}>)}
      </>
    )}
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:width" content="1800">
    <meta property="og:image:height" content="1200">
    <meta property="og:locale" content="en_US">
    <meta property="og:site_name" content="mattwaler.com">
    <ClientRouter />
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="abstract" content={description}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://mattwaler.nyc3.cdn.digitaloceanspaces.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400..900&display=swap" rel="stylesheet">
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-60 focus:bg-black focus:text-white focus:font-medium focus:rounded-full focus:px-4 focus:py-2 focus:shadow-lg"
    >
      Skip to content
    </a>
    <Debug />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <!-- Back To Top -->
    <button
      type="button"
      aria-label="Back to top"
      class="button fixed bottom-3 right-3 z-50 p-3 shadow-lg hover:bg-gray-800 hover:cursor-pointer"
      x-data="{ show: false }"
      x-init="show = window.scrollY > 200"
      @scroll.window="show = window.scrollY > 200"
      x-cloak
      x-show="show"
      x-transition.duration.300ms
      @click="window.scrollTo({ top: 0 })"
    >
      <ArrowUp class="size-5" />
    </button>
    <script>
      import '../scripts/app.js'
    </script>
  </body>
</html>
